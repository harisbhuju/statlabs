# Copy to .env.local for local dev; set the same values in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=https://statlabs.si

# Neon Postgres connection string (Vercel → Storage → Neon creates this for you)
DATABASE_URL=

# Admin login for /admin
ADMIN_EMAIL=
# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=

# Random 32+ char strings, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET=
CMS_API_KEY=
CRON_SECRET=

# X (Twitter) data — https://twitterapi.io API key
X_API_KEY=

# Google Trends — official API (alpha) once approved:
GOOGLE_TRENDS_API_KEY=
GOOGLE_TRENDS_ENDPOINT=
# Optional fallback until then: https://serpapi.com
SERPAPI_KEY=
